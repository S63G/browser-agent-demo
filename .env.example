# 复制为 .env 后按需填写（程序只读取环境变量，不会自动加载此文件；PowerShell 中用 $env:NAME="value" 设置）
# 不填 LLM_API_KEY 时只跑脚本流程；选择器失效的步骤直接转人工，不会猜。

# 模型兜底：deepseek 或 qwen（通义千问/百炼 OpenAI 兼容模式）
LLM_PROVIDER=deepseek
LLM_API_KEY=
# 留空则用默认：deepseek -> deepseek-flash，qwen -> qwen-plus
LLM_MODEL=
# off | live | replay（replay 只回放 data/replay/ 里真实调用录下的结果）
LLM_MODE=
# 1 = 把真实调用的返回保存到 data/replay/
LLM_RECORD=0
# 每次工具调用最多调用模型的次数，超过即转人工
MAX_MODEL_CALLS=60

# 模拟老系统门户（python -m browser_agent portal）及其演示账号（虚构）
PORTAL_URL=http://127.0.0.1:8770
PORTAL_USER=op01
PORTAL_PASSWORD=Ruifeng#2026

# 浏览器：0 = 显示浏览器窗口（录屏用）；慢动作毫秒数
BROWSER_HEADLESS=1
BROWSER_SLOW_MO=0
# Chromium 不在默认位置时（例如装到其他磁盘）：
# PLAYWRIGHT_BROWSERS_PATH=

# 写操作审批：MCP server 自动启动的审批页端口；等待审批的秒数
APPROVAL_WEB=1
APPROVAL_PORT=8771
APPROVAL_TIMEOUT=300

# 输出目录（门户数据库、台账、截图与轨迹、下载的发票）
AGENT_OUT=
